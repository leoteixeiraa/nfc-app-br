# Copie este arquivo para .env e substitua os valores de exemplo.
POSTGRES_DB=nfcapp
POSTGRES_USER=nfcapp
POSTGRES_PASSWORD=change_me_to_a_long_random_password

SPRING_PROFILES_ACTIVE=docker
APP_DOMAIN=localhost
APP_PUBLIC_BASE_URL=http://localhost
APP_CORS_ALLOWED_ORIGINS=http://localhost
HTTP_PORT=80
SESSION_COOKIE_SECURE=false

# Firebase Authentication (configuração pública do app Web; obtenha no Firebase Console).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Sincronização de placas com a conta.
APP_ACCOUNT_TAGS_ENABLED=true

# Google Places API (New). Optional: manual Google review links remain available.
GOOGLE_PLACES_API_KEY=

# Necessário apenas para compose.prod.yml e DNS-01 via Cloudflare.
# Crie um token restrito à edição DNS da zona nfc.app.br; não o versione.
CADDY_DNS_API_TOKEN=

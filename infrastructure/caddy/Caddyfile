:80 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:8080
    }

    handle {
        root * /srv
        @shell not path *.js *.css *.svg *.png *.jpg *.jpeg *.webp *.woff2 *.ico
        header @shell Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
